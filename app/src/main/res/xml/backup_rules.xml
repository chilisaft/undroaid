<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for Android 11 and lower (Android 12+ uses data_extraction_rules.xml).
    The credentials file (server URL + API key, secure_prefs.xml) is excluded: its contents are
    encrypted with a key held in this device's Android Keystore, which is never backed up, so it
    couldn't be decrypted on another device anyway - the user just logs in again there.
    Plain preferences (theme etc.) are still backed up.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="secure_prefs.xml" />
</full-backup-content>
