<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup / device-transfer rules for Android 12+ (see backup_rules.xml for older versions and
    the reasoning): the Keystore-encrypted credentials file can't be decrypted on another device,
    so it's excluded from both.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="encrypted_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="encrypted_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
