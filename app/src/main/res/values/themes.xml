<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Shown between process start and the first Compose frame. `postSplashScreenTheme` swaps
        the activity back to the app's real theme automatically once the splash screen library
        hands off - see UndroaidActivity's splashScreen.setKeepOnScreenCondition.
    -->
    <style name="Theme.Undroaid.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AppCompat</item>
    </style>
</resources>
